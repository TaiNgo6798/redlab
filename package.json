{
  "name": "redlab",
  "version": "1.1.55",
  "description": "Chrome extension for teams that use Redmine and GitLab: time tracking, hours leaderboard, ticket-to-merge-request sync, and local OTP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaiNgo6798/redlab.git"
  },
  "homepage": "https://chromewebstore.google.com/detail/redlab/pimegpjllpdeeflnmfgkkoleobfncbjb",
  "bugs": {
    "url": "https://github.com/TaiNgo6798/redlab/issues"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "dev": "vite",
    "prepare": "husky install",
    "bump": "npm version --no-git-tag-version"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.36",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9.39.2",
    "husky": "^8.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
