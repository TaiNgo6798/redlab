{
  "name": "redlab",
  "version": "1.1.39",
  "description": "Chrome extension for Redmine time tracking, team leaderboards, GitLab ticket sync, and OTP codes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaiNgo6798/redlab.git"
  },
  "homepage": "https://github.com/TaiNgo6798/redlab#readme",
  "bugs": {
    "url": "https://github.com/TaiNgo6798/redlab/issues"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "dev": "nodemon --watch sidepanel --watch background.ts --watch utils --watch styles --watch manifest.json --watch public -e ts,tsx,css,json,html --exec 'npm run build'",
    "prepare": "husky install",
    "bump": "npm version --no-git-tag-version"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.36",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "husky": "^8.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@otplib/core": "^12.0.1",
    "@otplib/plugin-crypto-js": "^12.0.1",
    "@otplib/plugin-thirty-two": "^12.0.1",
    "antd": "^6.3.0",
    "buffer": "^6.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  }
}
