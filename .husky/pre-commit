#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Bump patch version
npm run bump patch

# Sync manifest.json version from package.json
node -e "const fs = require('fs'); const p = require('./package.json'); const m = require('./manifest.json'); m.version = p.version; fs.writeFileSync('./manifest.json', JSON.stringify(m, null, 2) + '\n');"

git add package.json manifest.json package-lock.json
