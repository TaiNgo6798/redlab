{
  "manifest_version": 3,
  "name": "RedLab",
  "short_name": "RedLab",
  "description": "Redmine time tracking and GitLab merge-request sync. Hours, team leaderboard, ticket status, and local OTP.",
  "version": "1.1.42",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
